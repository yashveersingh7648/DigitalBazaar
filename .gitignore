# Environment Files
# Ek hi command mein sab add karo:
cat >> .gitignore << 'EOF'

# Environment Files
.env
.env.local
.env.development
.env.production
frontend/.env
backend/.env
*.env

# Node Modules
node_modules/
frontend/node_modules/
backend/node_modules/

# Build
dist/
build/
frontend/dist/
frontend/build/

# Python
__pycache__/
*.pyc
backend/__pycache__/
venv/
env/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
EOF