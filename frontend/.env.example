# Vite ONLY reads env vars prefixed with VITE_ (not REACT_APP_ — that was the old
# Create React App convention, ignored now that this project uses Vite).
# Render dashboard -> frontend service -> Environment me inhi naamon se set karo,
# aur set/change karne ke baad "Clear build cache & deploy" karo (env vars build
# time par bake hote hain, sirf restart se naya value nahi uthta).

VITE_API_URL=https://digitalbazaar-backend-1qdt.onrender.com/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
