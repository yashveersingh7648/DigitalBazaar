# MongoDB Atlas free tier connection string
MONGO_URI=your_mongodb_connection_string_here

PORT=5000

# Any long random string (used to sign JWTs)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Google Cloud Console -> OAuth Client ID (Web application) se milega
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Ye email jab bhi register/login karega, automatically admin ban jayega
ADMIN_EMAIL=youradmin@example.com

# Note: Uploaded product images backend/uploads/ folder me local disk par save hoti hain.
# Render/Railway free tier jaisi hosting par disk ephemeral hoti hai — redeploy hone par
# uploads/ ka content delete ho sakta hai. Production ke liye Cloudinary/S3 jaisi storage
# service use karne ki recommendation hai (isi upload.js route ko wahan point kar dena).

# ---- Contact Page Email (optional) ----
# Contact form ki query hamesha database me save hoti hai (Admin Dashboard me dikhti hai),
# lekin agar aap seedha email bhi chahte ho to Gmail App Password use karo:
# 1. Google Account -> Security -> 2-Step Verification ON karo
# 2. Security -> App Passwords -> "Mail" ke liye ek 16-digit password generate karo
# 3. Neeche EMAIL_USER apna gmail, EMAIL_PASS wahi 16-digit app password (normal password NAHI)
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_digit_app_password

# Contact query kis email par jaani chahiye (default: yashveersingh7648@gmail.com)
CONTACT_EMAIL=yashveersingh7648@gmail.com
