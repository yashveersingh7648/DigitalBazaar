# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string_here

PORT=5000

# Any long random string (used to sign JWTs)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Google Cloud Console -> OAuth Client ID (Web application) se milega
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---- Admin login ----
# Jo email yahan daloge, wahi site ka ADMIN hai. Ye email normal /register se
# create NAHI ho sakta (reserved) — login page se seedha ADMIN_PASSWORD ke saath
# login karo, account pehli baar login par khud-ba-khud ban jaata hai.
ADMIN_EMAIL=youradmin@example.com
ADMIN_PASSWORD=choose_a_strong_admin_password

# ---- Image storage (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- SEO / Sitemap ----
# Jahan aapki FRONTEND website actually live hai (backend URL nahi!) — /sitemap.xml
# aur /robots.txt yahi domain use karke product/category URLs banate hain.
FRONTEND_URL=https://digitalbazaar.onrender.com

# ---- Contact Page Email (optional) ----
# OPTION A — SendGrid:
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_USER_SAND=your_verified_sendgrid_sender_email@example.com
# OPTION B — Gmail App Password:
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_digit_app_password

# Contact query kis email par jaani chahiye
CONTACT_EMAIL=yashveersingh7648@gmail.com
